android_app {
    name: "CarrierSettings",
    srcs: ["src/**/*.kt"],
    platform_apis: true,
    certificate: "platform",
    system_ext_specific: true,
    privileged: true,
    static_libs: [
        "androidx.preference_preference",
        "carriersettings_proto",
    ],
    required: [
        "CarrierSettingsOverlay",
        "prebuilt_carrier_settings",
        "privapp_whitelist_com.android.carriersettings",
    ],
}

prebuilt_etc {
    name: "privapp_whitelist_com.android.carriersettings",
    system_ext_specific: true,
    relative_install_path: "permissions",
    src: "com.android.carriersettings.xml",
    filename_from_src: true,
}
